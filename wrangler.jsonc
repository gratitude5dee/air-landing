{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "air-landing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "AIR_DATABASE_ENV": "production",
    "AIR_CINEMATIC": "true",
    "AIR_WAITLIST_ALLOWED_ORIGINS": "https://wzrd.tech,https://www.wzrd.tech",
    "NEXT_PUBLIC_CAL_LINK": "https://cal.com/5deestudios/air-onboarding",
    "AIR_BACKEND_ORIGIN": "https://air-backend.gratitude-8f4.workers.dev"
  }
}
