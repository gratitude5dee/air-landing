# Landing proxy routes are disabled unless every parity-preview gate passes.
# Use only a protected Vercel Preview and an explicit non-production HTTPS origin.
# Vercel must also supply VERCEL_AUTOMATION_BYPASS_SECRET for the protected preview.
AIR_CINEMATIC=false
AIR_MEMORY_ECHO=false
AIR_PARITY_PROXY_ENABLED=false
AIR_PARITY_BACKEND_ORIGIN=https://air-staging.example.com

# Dedicated Neon store for this deployment environment. Preview and production
# must use separate databases. Set AIR_DATABASE_ENV to the exact VERCEL_ENV
# (`preview` or `production`); local development may use `development`.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
AIR_DATABASE_ENV=development
AIR_ID_HASH_SECRET=replace-with-at-least-32-random-characters

# Vercel Cron sends this value as an Authorization bearer token. Use 32+ random
# characters. It protects the daily 12-month preorder / 30-day attempt prune.
CRON_SECRET=replace-with-at-least-32-random-characters

# Cal link discovered in the existing WZRD launch materials.
NEXT_PUBLIC_CAL_LINK=https://cal.com/5deestudios/air-onboarding
